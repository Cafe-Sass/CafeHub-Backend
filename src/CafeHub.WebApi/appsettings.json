{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenApi": {
    "ExposeOutsideDevelopment": false
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "ClockSkewSeconds": 30,
    "Tenant": {
      "Audience": "",
      "AccessTokenLifetimeMinutes": 15
    }
  },
  "RefreshTokens": {
    "LifetimeDays": 7
  },
  "RateLimiting": {
    "AdminAuth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Transport": {
    "Hsts": {
      "MaxAgeDays": 365,
      "IncludeSubDomains": false,
      "Preload": false
    },
    "HttpsPort": null,
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  },
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "PlatformSeed": {
    "SuperAdminEmail": "",
    "SuperAdminPassword": ""
  },
  "AllowedHosts": "*"
}
