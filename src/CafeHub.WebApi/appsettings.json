{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenApi": {
    "ExposeOutsideDevelopment": false
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "RefreshTokens": {
    "LifetimeDays": 7
  },
  "RateLimiting": {
    "AdminAuth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "AllowedHosts": "*"
}
