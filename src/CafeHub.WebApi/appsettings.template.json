{
  "ConnectionStrings": {
    "Master": "<set-via-user-secrets>",
    "TenantDesignTime": "<set-via-user-secrets>"
  },
  "TenantDatabases": {
    "Host": "",
    "Port": 5432,
    "SslMode": "Prefer",
    "MaxPoolSize": 10
  },
  "OpenApi": {
    "ExposeOutsideDevelopment": false
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "ClockSkewSeconds": 30,
    "Tenant": {
      "Audience": "",
      "AccessTokenLifetimeMinutes": 15
    }
  },
  "RefreshTokens": {
    "LifetimeDays": 7
  },
  "RateLimiting": {
    "AdminAuth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Global": {
      "PermitLimit": 300,
      "WindowSeconds": 60
    }
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowedMethods": [
      "GET",
      "POST",
      "PUT",
      "PATCH"
    ],
    "AllowedHeaders": [
      "Authorization",
      "Content-Type",
      "Idempotency-Key",
      "X-Correlation-Id"
    ],
    "ExposedHeaders": [
      "X-Correlation-Id",
      "Retry-After"
    ],
    "AllowCredentials": false,
    "MaxAgeSeconds": 600
  },
  "RequestLimits": {
    "MaxBodyBytes": 1048576,
    "MaxHeadersTotalBytes": 32768
  },
  "Transport": {
    "Hsts": {
      "MaxAgeDays": 365,
      "IncludeSubDomains": false,
      "Preload": false
    },
    "HttpsPort": null,
    "ForwardedHeaders": {
      "Enabled": false,
      "KnownProxies": [],
      "KnownNetworks": [],
      "ForwardLimit": 1
    }
  },
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "PlatformSeed": {
    "SuperAdminEmail": "",
    "SuperAdminPassword": ""
  },
  "Payments": {
    "Provider": "Mock",
    "Mock": {
      "Outcome": "Succeed",
      "AllowOutsideDevelopment": false
    }
  }
}
