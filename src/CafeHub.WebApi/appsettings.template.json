{
  "ConnectionStrings": {
    "Master": "<set-via-user-secrets>",
    "TenantDesignTime": "<set-via-user-secrets>"
  },
  "TenantConnections": {
    "<SecretReference>": "<set-via-user-secrets>"
  },
  "OpenApi": {
    "ExposeOutsideDevelopment": false
  },
  "Jwt": {
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenLifetimeMinutes": 15,
    "ClockSkewSeconds": 30
  },
  "RefreshTokens": {
    "LifetimeDays": 7
  },
  "RateLimiting": {
    "AdminAuth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  }
}
